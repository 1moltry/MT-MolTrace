# Normalize line endings in the repository to LF regardless of platform.
# Windows development + Linux CI would otherwise produce noisy diffs.
* text=auto eol=lf

# Windows batch launchers must keep CRLF to run correctly.
*.bat text eol=crlf

# Binary formats: never touch.
*.abf binary
*.png binary
*.jpg binary
*.xlsx binary
*.docx binary

# --- release export: dev-only paths never ship in `git archive` output ---
# (the shipped artifact is the PyInstaller bundle built by release/build_release.py;
#  these rules keep the staged source tree free of tests, dev docs and agent configs)
/tests/ export-ignore
/.github/ export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/DEVLOG.md export-ignore
/DEVELOPMENT.md export-ignore
/CONTRIBUTING.md export-ignore
/PLAN_*.md export-ignore
/data/ export-ignore
/release/ export-ignore
/MOLTRACE.bat export-ignore
/MOLTRACE-debug.bat export-ignore
